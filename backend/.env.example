# Copy to `.env` (gitignored). Used by Kamal (`secrets_path`) and local Rails via dotenv.

# --- Kamal / production ---
KAMAL_REGISTRY_PASSWORD=
# Skriv noe random her for å få backend til å kjøre!
SECRET_KEY_BASE=
DATABASE_URL=postgresql://neondb_owner:npg_wrOk0X9MUVaC@ep-morning-bread-abghkzyw-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Optional: host authorization (defaults in production.rb if unset) ---
# RAILS_HOST=slides.example.com

# --- CORS (comma-separated; set in deploy.yml `env.clear` for production) ---
# ALLOWED_ORIGINS=https://slides.example.com

# --- OAuth (optional; omit provider blocks in initializer if vars blank) ---
# Redirect URIs in Google/GitHub consoles must include:
#   https://YOUR_HOST/api/v1/auth/google_oauth2/callback
#   https://YOUR_HOST/api/v1/auth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- OAuth redirect back to SPA after login (production: public https URL) ---
# FRONTEND_URL=https://slides.rubynor.com

# --- If authorize URL uses http instead of https behind proxy, set full origin ---
# OMNIAUTH_FULL_HOST=https://slides.rubynor.com
