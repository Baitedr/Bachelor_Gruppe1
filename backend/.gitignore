# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

.byebug_history
.env
.env-common

# Kamal local hook file (optional; team uses `secrets_path: .env` in deploy.yml)
/.kamal/secrets
/.kamal/secrets-common
