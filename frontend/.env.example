# Copy to `.env` (optional). Vite reads `VITE_*` vars.

# Rails URL for dev proxy (HTTP + WebSocket /cable). Default: http://localhost:3000
# VITE_DEV_BACKEND_ORIGIN=http://localhost:3002

# Override API base (skip proxy). Example: http://localhost:3002/api/v1
# VITE_API_BASE_URL=

# Override Action Cable origin (rare; default is same host as the SPA)
# VITE_WS_URL=
